# 服務
PORT=8080
# 數據目錄：本地設定（含機密）與知識倉庫的工作副本
DATA_DIR=./data
# 管理員密碼（不設定時首次啟動自動生成，寫入 DATA_DIR/initial-admin-password.txt）
ADMIN_PASSWORD=
# 對外訪問地址（用於教程中的 API 根地址與 OpenRouter HTTP-Referer）
PUBLIC_BASE_URL=

# 知識持久化：使用你指定的 Git 倉庫（也可在後台「設定 › 知識倉庫」配置）
KNOWLEDGE_GIT_URL=
KNOWLEDGE_GIT_BRANCH=main
# https 倉庫的存取權杖（GitHub 細粒度 PAT：Contents 讀寫）；ssh 倉庫使用本機 ssh 金鑰
KNOWLEDGE_GIT_TOKEN=
KNOWLEDGE_GIT_SUBDIR=knowledge

# 自然語言組織（OpenRouter）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 管道憑證：在管道 headers 中以 ${env:變數名} 引用，例如
# GATEWAY_TOKEN=
